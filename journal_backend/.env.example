# FastAPI backend environment variables

# PostgreSQL connection URL (provided by the database container).
# The database container may provide a URL like:
#   postgresql://user:password@host:port/dbname
# This app will automatically normalize it to:
#   postgresql+asyncpg://user:password@host:port/dbname
# Example (matches local dev db_connection.txt format):
# POSTGRES_URL=postgresql://appuser:dbuser123@localhost:5000/myapp
POSTGRES_URL=

# Optional: used for CORS in local dev (defaults to http://localhost:3000)
FRONTEND_ORIGIN=http://localhost:3000

# Optional: application environment
APP_ENV=development
